# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# ---- Neon PostgreSQL -------------------------------------------------------
# Use the DIRECT (non-pooled) endpoint host — no "-pooler" in the hostname.
# Flyway's migration lock needs a real session, which PgBouncer's transaction
# pooling does not provide.
DATABASE_URL=jdbc:postgresql://ep-xxxx-xxxxxxxx.ap-southeast-1.aws.neon.tech/dental_pms?sslmode=require
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5

# ---- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# The app refuses to start if this is unset or shorter than 32 characters.
JWT_SECRET=
JWT_ISSUER=dental-pms
JWT_AUDIENCE=dental-pms-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ---- First-run bootstrap ---------------------------------------------------
# Used only when the app_user table is empty, to create the first dentist.
# Change the password immediately after the first login, then clear these.
BOOTSTRAP_DENTIST_EMAIL=
BOOTSTRAP_DENTIST_PASSWORD=
BOOTSTRAP_DENTIST_NAME=

# ---- Server ----------------------------------------------------------------
# 0.0.0.0 binds every interface, so other machines on the LAN can reach the server.
# Use 127.0.0.1 to restrict it to this machine.
SERVER_HOST=0.0.0.0
PORT=8080

# Host-side port mappings used by compose.yaml (the container always listens on 8080).
HOST_PORT=8080
DB_PORT=5432
