# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# This template configures the LOCAL environment: the backend running on your machine
# (`./kotlin run`) against your own Neon "local" branch. The `dev` and `prod` environments
# run on Cloud Run and get these values from the service manifests + Secret Manager
# (see deploy/cloudrun/ and docs/environments.md) — not from this file.

# ---- Environment -----------------------------------------------------------
# Selects the deployment profile: local | dev | prod. `prod`/`production` turns on
# production-only guards (e.g. CORS_ALLOWED_HOSTS becomes mandatory). Anything else is `dev`.
APP_ENV=local

# ---- Neon PostgreSQL (local branch) ----------------------------------------
# Point this at your own Neon "local" branch. Use the DIRECT (non-pooled) endpoint host
# — no "-pooler" in the hostname — because Flyway's migration lock needs a real session,
# which PgBouncer's transaction pooling does not provide.
DATABASE_URL=jdbc:postgresql://ep-xxxx-xxxxxxxx.ap-southeast-1.aws.neon.tech/dental_pms?sslmode=require
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5

# ---- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# The app refuses to start if this is unset or shorter than 32 characters.
JWT_SECRET=
JWT_ISSUER=dental-pms
JWT_AUDIENCE=dental-pms-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ---- First-run bootstrap ---------------------------------------------------
# Used only when the app_user table is empty, to seed the initial accounts. Each role is
# seeded only if BOTH its email and password are set, so you can create one or both.
# Change the passwords immediately after the first login, then clear these.
BOOTSTRAP_SYSADMIN_EMAIL=
BOOTSTRAP_SYSADMIN_PASSWORD=
BOOTSTRAP_SYSADMIN_NAME=

BOOTSTRAP_DENTIST_EMAIL=
BOOTSTRAP_DENTIST_PASSWORD=
BOOTSTRAP_DENTIST_NAME=

# ---- CORS ------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API cross-origin, as host:port
# (no scheme). List your front-end dev server origin(s) — 5173 is Vite's default.
# When APP_ENV != prod an unset value falls back to localhost:8080 / 127.0.0.1:8080.
# When APP_ENV=prod this MUST be set, or the app refuses to start.
CORS_ALLOWED_HOSTS=localhost:5173,127.0.0.1:5173

# ---- Server ----------------------------------------------------------------
# 0.0.0.0 binds every interface, so other machines on the LAN can reach the server.
# Use 127.0.0.1 to restrict it to this machine.
SERVER_HOST=0.0.0.0
# Default 8080. Override for a local `./kotlin run` when 8080 is already taken (e.g. a
# container is bound to it): e.g. PORT=8081. To move the compose container's *published*
# port instead, set HOST_PORT below — the container itself always listens on 8080.
PORT=8080

# Host-side port mappings used by compose.yaml (the container always listens on 8080).
HOST_PORT=8080
DB_PORT=5432
